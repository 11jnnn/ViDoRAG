# 导入三个字符串模板：选页提示词、证据检查提示词、最终回答提示词。
from agent.agent_prompt import seeker_prompt,inspector_prompt,answer_prompt
# arrangement_map_dict 按图片数量选择网格排列；另两个字典提供页面编号说明。
# page_map_dict_normal 用于独立多图，page_map_dict 用于一张拼图中的多个页面。
from agent.map_dict import arrangement_map_dict,page_map_dict_normal,page_map_dict

# 把模型回复中的 JSON 文本解析成 Python 对象，正常情况下得到字典。
from utils.parse_tool import extract_json
# 将图片路径对应的页面拼成一张 PIL 图片；本文件没有传入 bbox 坐标。
